# Copy to .env and fill in. Never commit .env.
APP_ENV=development
LOG_LEVEL=INFO
API_CORS_ORIGINS=http://localhost:3000

# Storage
DATABASE_URL=postgresql+psycopg://seehere:seehere@localhost:5433/seehere
MEDIA_DIR=./var/media
MEDIA_RETENTION_HOURS=24

# Upload limits (re-tuned from measured server capacity in Task 33)
MAX_UPLOAD_MB=500
MAX_VIDEO_DURATION_S=600

# Vultr Serverless Inference (OpenAI-compatible). Leave the key empty to run local fallbacks only.
VULTR_INFERENCE_BASE_URL=https://api.vultrinference.com/v1
VULTR_INFERENCE_API_KEY=
VULTR_VISION_MODEL=qwen3.8-flash-next
VULTR_TTS_MODEL=qwen3-tts-12hz-1.7b
VULTR_STT_MODEL=whisper-large-v3-turbo

# Optional partner providers
GEMINI_API_KEY=
SMALLEST_API_KEY=

# Local speech-to-text with word timestamps (faster-whisper)
LOCAL_STT_MODEL=small.en

# Scheduling
EXTENDED_PAUSE_BUDGET_PCT=8.0
SOLVER_TIME_LIMIT_S=2.0

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
