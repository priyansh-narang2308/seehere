# Production settings for deploy/docker-compose.prod.yml. Copy to deploy/.env (git-ignored).
# deploy/bootstrap.sh fills SEEHERE_DOMAIN and POSTGRES_PASSWORD for you.

# Public host name. Without a domain, use the server IP with dashes: 203-0-113-7.sslip.io
SEEHERE_DOMAIN=
# Long random password for the bundled Postgres (bootstrap.sh generates one).
POSTGRES_PASSWORD=

LOG_LEVEL=INFO
MEDIA_RETENTION_HOURS=24
MAX_UPLOAD_MB=500
MAX_VIDEO_DURATION_S=1800
LOCAL_STT_MODEL=small.en

# Vision model for keyframes: none (OCR only), vultr (the live demo) or gemini. Each keyframe is one request.
VISION_PROVIDER=none
GEMINI_API_KEY=
GEMINI_VISION_MODEL=gemini-3.5-flash-lite

# Vultr Serverless Inference (a Serverless Inference key, not the account API key).
VULTR_INFERENCE_BASE_URL=https://api.vultrinference.com/v1
VULTR_INFERENCE_API_KEY=

# Voice for descriptions: piper (local, default) or vultr.
TTS_PROVIDER=piper
